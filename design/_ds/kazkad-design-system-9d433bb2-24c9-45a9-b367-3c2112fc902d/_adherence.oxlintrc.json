      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|info|risk)$/]",
        "message": "<Toast> tone must be one of 'ok' | 'info' | 'risk'."
